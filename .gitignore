# Node artifact files
node_modules/
dist/
env/
venv/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv
*.csv

# Checkpoints de entrenamiento PPO (el modelo final se guarda aparte)
models/ppo_racer/last.pt
models/ppo_racer/best.pt
models/ppo_racer/train.log
models/ablations/*/last.pt
models/ablations/*/best.pt
models/dqn_racer/last.pt
models/*.log
models/**/.terminado
